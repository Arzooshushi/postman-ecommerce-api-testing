    {
      "name": "Add Product to Cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseData = pm.response.json();",
              "",
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Cart ID exists\", function () {",
              "    pm.expect(responseData).to.have.property(\"id\");",
              "});",
              "",
              "pm.test(\"Correct user ID is returned\", function () {",
              "    pm.expect(responseData.userId).to.eql(1);",
              "});",
              "",
              "pm.test(\"Products array is not empty\", function () {",
              "    pm.expect(responseData.products).to.be.an(\"array\");",
              "    pm.expect(responseData.products.length).to.be.above(0);",
              "});",
              "",
              "pm.test(\"Correct product and quantity are added\", function () {",
              "    pm.expect(responseData.products[0].id).to.eql(10);",
              "    pm.expect(responseData.products[0].quantity).to.eql(2);",
              "});",
              "",
              "pm.test(\"Total and discounted total are correct\", function () {",
              "    pm.expect(responseData.total).to.be.a(\"number\");",
              "    pm.expect(responseData.discountedTotal).to.be.a(\"number\");",
              "    pm.expect(responseData.totalProducts).to.eql(1);",
              "    pm.expect(responseData.totalQuantity).to.eql(2);",
              "});",
              "",
              "pm.test(\"Product contains title and price\", function () {",
              "    pm.expect(responseData.products[0]).to.have.property(\"title\");",
              "    pm.expect(responseData.products[0]).to.have.property(\"price\");",
              "    pm.expect(responseData.products[0].price).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
